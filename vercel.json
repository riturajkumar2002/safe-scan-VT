{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/scan-url", "dest": "/api/scan-url" },
    { "src": "/scan-file", "dest": "/api/scan-file" },
    { "src": "/analysis/(.*)", "dest": "/api/analysis/$1" },
    { "src": "/feedback(.*)", "dest": "/api/feedback$1" },
    { "src": "/api/counter", "dest": "/api/api/counter" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
